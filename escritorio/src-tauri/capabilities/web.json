{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "web-de-morgan",
  "description": "La web de Morgan dentro del programa (5.3): solo lo inofensivo (lo decidí el 2026-10-04). Ni emparejar, ni consultar códigos, ni nada de Tauri.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://morgan-ia.vercel.app/*"]
  },
  "permissions": [
    "allow-resumen",
    "allow-pausar",
    "allow-reanudar",
    "allow-ultimas",
    "allow-abrir-ajustes",
    "allow-pantalla-emparejar",
    "allow-programa",
    "allow-actualizar-ahora"
  ]
}
