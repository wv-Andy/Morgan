{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morgan para Windows",
  "mainBinaryName": "Morgan",
  "version": "5.3.5",
  "identifier": "io.github.wv-andy.morgan",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Morgan",
    "shortDescription": "Morgan, tu asistente, en tu PC",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "agente/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "installerHooks": "./hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBNjM2RjNBNjUxNDk2NEIKUldSTGxoUmxPbTlqMnVqZUN3WHFpQjBLbTBacHZsTnNUWjJYSkI5RXpkMXRvcFRlNmg2aEJHUTgK",
      "endpoints": [
        "https://github.com/wv-Andy/Morgan/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
