{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morgan para Windows",
  "mainBinaryName": "Morgan",
  "version": "5.1.0",
  "identifier": "io.github.wv-andy.morgan",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Morgan",
        "width": 480,
        "height": 600,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Morgan",
    "shortDescription": "Morgan, tu asistente, en tu PC",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["agente/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "installerHooks": "./hooks.nsh"
      }
    }
  }
}
